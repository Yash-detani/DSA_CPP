// In this approach Auxillary Space is O(n)

void reverse(stack<int>& st){
  int top = st.top();
  reverse(st);
  stack<int> temp;
  
  while(!st.empty()){
    temp.push(st.top());
    st.pop();
    }
  st.push(top);
  while(!temp.empty()){
    st.push(temp.top())
    temp.pop();
    }
  }

// In this approach Auxillary Space is O(1)

void insertAtBottom(stack<int>& st, int element){
        if(st.empty()){
            st.push(element);
            return;
        }
        
        int top = st.top();
        st.pop();
        insertAtBottom(st, element);
        st.push(top);
    }
    
    void reverseStack(stack<int> &st) {
        // code here
        if(st.empty()){
            return;
        }
        
        int top = st.top();
        st.pop();
        
        reverseStack(st);
        
        insertAtBottom(st, top);
    }
