55. Jump Game

//Optimal Approach
bool canJump(vector<int>& nums) {
        int n = nums.size();
        
        if(n == 1)return true;

        

        int max_index = 0;

        for(int i=0;i<n;i++)
        {
            if(i > max_index) return false;

            max_index = max(max_index , i + nums[i]);
            
        }

    return true;
    }  
