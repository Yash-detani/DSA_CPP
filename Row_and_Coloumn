2352. Equal Row and Column Pairs

Brute Force:
int equalPairs(vector<vector<int>>& grid) {
        int count = 0;
        int n = grid.size();

        for(int r=0;r<n;r++){
            for(int c=0;c<n;c++){
                bool isEqual = true;
                for(int i=0;i<n;i++){
                    if(grid[r][i] != grid[i][c]){
                        isEqual = false;
                        break;
                    }
                }
                if(isEqual)
                count ++;
            }
        }
        return count;
    }

Optimal Approach:

int equalPairs(vector<vector<int>>& grid) {
        int count = 0;
        
        int n = grid.size();

        map<vector<int> , int> mp;

        for(int r=0;r<n;r++){
            mp[grid[r]]++;
        }

        for(int c=0;c<n;c++){
            vector<int> temp;

            for(int r=0;r<n;r++){
                temp.push_back(grid[r][c]);
            }
            count += mp[temp];
        }
        return count;
    }
