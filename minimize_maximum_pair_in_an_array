1877. Minimize Maximum Pair Sum in Array

int minPairSum(vector<int>& nums) {
        int maxi = ;
        int n = nums.size();
        sort(nums.begin() , nums.end());

        int i = 0 , j = n - 1;
        int sum = 0;
        while(i <= j){
            sum = nums[i++] + nums[j--];
            maxi = max(maxi , sum);
        }
        return maxi;
    }

